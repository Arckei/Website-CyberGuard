rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isKnownAdmin() {
      return isSignedIn()
        && (
          ["GiCGuDEbtNcjALETb7oto1HntYS2"].hasAny([request.auth.uid])
          || ["keithwilsonplays@gmail.com"].hasAny([request.auth.token.email])
        );
    }

    function isAdmin() {
      return isKnownAdmin() || (isSignedIn() && myRole() == "admin");
    }

    // ---------------- users ----------------
    match /users/{userId} {
      allow read: if isSignedIn();

      // Regular accounts can only create themselves as students. Known/admin
      // accounts can also seed or repair app user docs during an admin save.
      allow create: if (isOwner(userId)
                        && request.resource.data.role == "student")
                    || isAdmin();

      // Users can update their own profile (name, email, avatar, photo,
      // settings) but the role field must stay exactly what it already was.
      // An admin can update any user's doc.
      allow update: if (isOwner(userId)
                        && request.resource.data.role == resource.data.role)
                    || isAdmin();

      allow delete: if isAdmin();
    }

    function isJoiningClass() {
      let before = resource.data;
      let after = request.resource.data;
      return isSignedIn()
        && after.name == before.name
        && after.section == before.section
        && after.code == before.code
        && after.teacher == before.teacher
        && after.modules == before.modules
        && after.students.size() == before.students.size() + 1
        && after.students.hasAll(before.students)
        && after.students.hasAny([request.auth.uid])
        && !before.students.hasAny([request.auth.uid]);
    }

    // ---------------- classes ----------------
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isJoiningClass();
    }

    // ---------------- progress ----------------
    match /progress/{progressId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
                             && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ---------------- lessons ----------------
    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
                    && request.resource.data.dataUrl is string
                    && request.resource.data.dataUrl.size() < 950000;
      allow update, delete: if isAdmin();
    }

    // ---------------- appState ----------------
    match /appState/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}

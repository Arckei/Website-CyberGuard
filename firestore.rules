rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================================
    // HELPER FUNCTIONS
    // ==========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Safe role lookup with existence check to prevent rules runtime crashes
    function myRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "student";
    }

    // Admin authorization via Auth Custom Claims or verified admin fallbacks
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        (
          request.auth.token.get('email_verified', false) == true &&
          request.auth.token.email in ["keithwilsonplays@gmail.com", "neeon357@gmail.com"]
        ) ||
        request.auth.uid in ["GiCGuDEbtNcjALETb7oto1HntYS2", "nybe9fkHsMVysaCSMqG2oCWPEIn1"] ||
        myRole() == "admin"
      );
    }

    // ==========================================================================
    // USERS COLLECTION
    // ==========================================================================

    match /users/{userId} {
      // Users can read only their own profile; Admins can read all profiles
      allow read: if isOwner(userId) || isAdmin();

      // New users can only register themselves with role == "student"
      allow create: if (isOwner(userId) && request.resource.data.role == "student")
                    || isAdmin();

      // Users can update their profile but cannot escalate their role
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role)
                    || isAdmin();

      allow delete: if isAdmin();
    }

    // ==========================================================================
    // CLASSES COLLECTION
    // ==========================================================================

    function isJoiningClass() {
      let before = resource.data;
      let after = request.resource.data;
      let studentUid = request.auth.uid;

      // Ensure class metadata remains unaltered during student join
      let metadataUnchanged = after.name == before.name
        && after.section == before.section
        && after.code == before.code
        && after.teacher == before.teacher
        && after.modules == before.modules;

      // Ensure student is added exactly once
      let studentAdded = !before.students.hasAny([studentUid])
        && after.students.hasAll(before.students)
        && after.students.hasAny([studentUid])
        && after.students.size() == before.students.size() + 1;

      // Ensure joining student's initial score is set to 0
      let scoreValid = !before.scores.keys().hasAll([studentUid])
        ? (after.scores[studentUid] == 0)
        : (after.scores[studentUid] == before.scores[studentUid]);

      return isSignedIn() && metadataUnchanged && studentAdded && scoreValid;
    }

    match /classes/{classId} {
      // Students can read classes they belong to; Admins can read all classes
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.students);

      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isJoiningClass();
    }

    // ==========================================================================
    // PROGRESS COLLECTION
    // ==========================================================================

    match /progress/{progressId} {
      // Students can read only their own quiz progress; Admins can read all progress
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Students can create/update only their own progress record;
      // Admins can write progress records for any student (needed for
      // class-wide saves in saveCyberGuardData()).
      allow create, update: if isAdmin() || (
                              isSignedIn()
                              && request.resource.data.userId == request.auth.uid
                              && request.resource.data.classId is string
                            );

      allow delete: if isAdmin();
    }

    // ==========================================================================
    // LESSONS COLLECTION
    // ==========================================================================

    match /lessons/{lessonId} {
      // All authenticated users can read lesson materials
      allow read: if isSignedIn();

      // Only admins can upload lessons; enforce max 950KB for base64 fallback data
      allow create: if isAdmin()
                    && (
                      !request.resource.data.keys().hasAll(['dataUrl']) ||
                      (request.resource.data.dataUrl is string && request.resource.data.dataUrl.size() < 950000)
                    );

      allow update, delete: if isAdmin();
    }

    // ==========================================================================
    // APP STATE COLLECTION
    // ==========================================================================

    match /appState/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}

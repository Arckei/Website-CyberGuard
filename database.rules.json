{
  /* Visit https://firebase.google.com/docs/database/security to learn more about security rules. */
  "rules": {
    ".read": false,
    ".write": false,

    /* Mirrors isAdmin() in firestore.rules: a custom claim, a verified
       email match, or one of the two hardcoded bootstrap accounts. RTDB
       rules can't look up a Firestore users/{uid}.role field (separate
       database), so this list has to be kept in sync by hand with
       firestore.rules and services/firebase-service.js's ADMIN_* sets. */

    /* Full quiz including correct answers — admin only, always. */
    "quizzes": {
      ".read": "auth != null && (auth.token.admin === true || auth.uid === 'GiCGuDEbtNcjALETb7oto1HntYS2' || auth.uid === 'nybe9fkHsMVysaCSMqG2oCWPEIn1' || auth.token.email === 'keithwilsonplays@gmail.com' || auth.token.email === 'neeon357@gmail.com')",
      ".write": "auth != null && (auth.token.admin === true || auth.uid === 'GiCGuDEbtNcjALETb7oto1HntYS2' || auth.uid === 'nybe9fkHsMVysaCSMqG2oCWPEIn1' || auth.token.email === 'keithwilsonplays@gmail.com' || auth.token.email === 'neeon357@gmail.com')"
    },

    /* Points a class at its current session id. Students need to read this
       to find the live quiz; only admins open/change it. */
    "classActiveSession": {
      ".read": "auth != null",
      "$classId": {
        ".write": "auth != null && (auth.token.admin === true || auth.uid === 'GiCGuDEbtNcjALETb7oto1HntYS2' || auth.uid === 'nybe9fkHsMVysaCSMqG2oCWPEIn1' || auth.token.email === 'keithwilsonplays@gmail.com' || auth.token.email === 'neeon357@gmail.com')"
      }
    },

    /* Public live-session state (status, current question WITHOUT the
       answer key, running scores, participants). Safe for any signed-in
       user to read. */
    "quizSessions": {
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.admin === true || auth.uid === 'GiCGuDEbtNcjALETb7oto1HntYS2' || auth.uid === 'nybe9fkHsMVysaCSMqG2oCWPEIn1' || auth.token.email === 'keithwilsonplays@gmail.com' || auth.token.email === 'neeon357@gmail.com')",

        "participants": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true || auth.uid === 'GiCGuDEbtNcjALETb7oto1HntYS2' || auth.uid === 'nybe9fkHsMVysaCSMqG2oCWPEIn1' || auth.token.email === 'keithwilsonplays@gmail.com' || auth.token.email === 'neeon357@gmail.com')"
          }
        }
      }
    },

    /* Kept OUTSIDE quizSessions on purpose — see the note in
       services/quiz-service.js. Only the host (admin) can read submitted
       answers; a student can only write their own. */
    "quizAnswers": {
      "$sessionId": {
        "$questionId": {
          ".read": "auth != null && (auth.token.admin === true || auth.uid === 'GiCGuDEbtNcjALETb7oto1HntYS2' || auth.uid === 'nybe9fkHsMVysaCSMqG2oCWPEIn1' || auth.token.email === 'keithwilsonplays@gmail.com' || auth.token.email === 'neeon357@gmail.com')",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },

    /* Same reasoning as quizAnswers. */
    "quizMinigameResults": {
      "$sessionId": {
        ".read": "auth != null && (auth.token.admin === true || auth.uid === 'GiCGuDEbtNcjALETb7oto1HntYS2' || auth.uid === 'nybe9fkHsMVysaCSMqG2oCWPEIn1' || auth.token.email === 'keithwilsonplays@gmail.com' || auth.token.email === 'neeon357@gmail.com')",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
